# EL10 LIMS hosts: OL10 AppStream MariaDB 10.11, with python3-PyMySQL for the system python as
# config-lims-database installs it; ansible-core 2.16 and the repo's pinned collections (run.sh)
FROM docker.io/library/oraclelinux:10
RUN dnf -y install mariadb-server mariadb python3-PyMySQL python3-pip procps-ng util-linux \
 && python3 -m venv /opt/ansible && /opt/ansible/bin/pip install -q "ansible-core>=2.16,<2.17" \
 && dnf clean all
COPY requirements.yml /tmp/requirements.yml
RUN /opt/ansible/bin/ansible-galaxy collection install -r /tmp/requirements.yml
