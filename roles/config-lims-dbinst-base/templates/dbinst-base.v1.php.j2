<?php
/*
 * Shared dbinst configuration, schema v1.
 *
 * Rendered once by ansible (config-lims-dbinst-base), on first install
 * only -- a later ansible run never re-renders this file, so changing
 * dbinst_base_values afterward has no effect on an already-provisioned
 * host. Edit this file directly to change a value (e.g. enable_GMP) here.
 *
 * Instance identity and credentials do not belong in this file: they live in
 * one validated overlay per instance under instances/.
 */
return array(
  'schema_version' => 1,
  'values' => array(
{% for key, value in dbinst_base_values | dictsort %}
    {{ "'%s'"|format(key) }} => {% if value is boolean %}{{ 'true' if value else 'false' }}{% elif value is number %}{{ value }}{% else %}'{{ value | replace("\\", "\\\\") | replace("'", "\\'") }}'{% endif %},
{% endfor %}
  )
);
